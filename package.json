{
  "name": "digital-human",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "client": "yarn --cwd apps/frontend dev",
    "server": "yarn --cwd apps/backend dev",
    "lip-sync": "cd apps/lip-sync && uv run uvicorn lip_sync.main:app --reload --port 8000",
    "dev": "npm-run-all --parallel client server lip-sync",
    "dev:js-only": "npm-run-all --parallel client server"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "npm-run-all": "^4.1.5"
  }
}
